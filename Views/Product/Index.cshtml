@model IEnumerable<QuanLySanPham.Models.Product>

@{
    ViewData["Title"] = "Danh sách Sản phẩm";
}

<div class="container mt-4">
    <!-- Phần Header: Tiêu đề và nút Thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">📦 Quản lý Sản phẩm</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm rounded-pill px-4 fw-bold">
            + Thêm mới Sản phẩm
        </a>
    </div>

    <!-- Phần Bảng dữ liệu -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center" style="width: 10%">ID</th>
                            <th style="width: 30%">Tên Sản phẩm</th>
                            <th style="width: 15%">Danh mục</th>
                            <th class="text-end" style="width: 20%">Đơn giá</th>
                            <th class="text-center" style="width: 25%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-secondary">
                                        #@item.Id
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        @item.Name
                                    </td>
                                    <td class="text-capitalize">
                                        <span class="badge bg-info-subtle text-info">@(item.Category?.Name ?? "Chưa có")</span>
                                    </td>
                                    <td class="text-end text-danger fw-bold">
                                        @string.Format("{0:N0} VNĐ", item.Price)
                                    </td>
                                    <td class="text-center">
                                        <!-- Các nút Action -->
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary mx-1">Sửa</a>
                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info mx-1">Chi tiết</a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger mx-1">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Trạng thái trống khi chưa có dữ liệu -->
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <span class="fs-4 d-block mb-2">📭</span>
                                    <em>Chưa có sản phẩm nào trong cơ sở dữ liệu.</em>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>