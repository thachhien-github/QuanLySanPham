@model QuanLySanPham.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
    bool isUsed = ViewBag.IsUsed is bool b && b;
    int usedByCount = ViewBag.UsedByCount is int c ? c : 0;
}

<div class="container mt-4">
    <h2 class="text-danger">🗑️ Xóa danh mục</h2>

    @if (isUsed)
    {
        <div class="alert alert-warning mt-3" role="alert">
            <div class="fw-semibold">Không thể xóa!</div>
            <div class="small text-muted">Danh mục <b>@Model.Name</b> đang được sử dụng bởi <b>@usedByCount</b> sản phẩm.</div>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Back</a>
    }
    else
    {
        <p>Bạn có chắc chắn muốn xóa?</p>
        <p class="fw-semibold">@Model.Name</p>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
        </form>
    }
</div>

